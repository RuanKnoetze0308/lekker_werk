# PostgreSQL 18
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lekkerwerk

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Used to encrypt integration credentials and bot tokens at rest.
APP_ENCRYPTION_KEY=

# Public base URL used in QR codes and webhook registration.
APP_URL=http://localhost:3000

# Shared secret that protects /api/jobs/* (call from a scheduler / cron).
CRON_SECRET=

# Optional: WhatsApp Business Cloud API (platform level app secret for signature checks)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# PayFast (https://www.payfast.co.za). Keep real values in .env.local only.
# PAYFAST_MODE=sandbox uses sandbox.payfast.co.za (needs sandbox merchant credentials).
PAYFAST_MODE=live
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Dev only: let ITN logic be tested locally without PayFast's IP/validate callbacks.
# PAYFAST_SKIP_REMOTE_CHECKS=1
# Dev only: allow LIVE checkout while APP_URL is not a public https URL (PayFast cannot reach localhost,
# so a real payment would never be recorded). Leave unset.
# PAYFAST_ALLOW_LOCAL_LIVE=1
