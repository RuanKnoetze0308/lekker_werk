# PostgreSQL 18 (16/17 work too). On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lekkerwerk

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Encrypts integration credentials, bot tokens and QR tokens at rest.
# MUST be identical everywhere the same database is used (moving data to Railway = copy this value).
APP_ENCRYPTION_KEY=

# Optional: separate key for RFID/NFC/PIN hashes (32 random bytes, base64, same command as above).
# Lets APP_ENCRYPTION_KEY be rotated without re-enrolling cards. Existing cards keep working and
# move to this key the next time they are used. Never change it once set.
# CREDENTIAL_HASH_KEY=

# Public base URL used in QR codes and webhook registration (https in production).
APP_URL=http://localhost:3001

# How many proxies in front of the app append to X-Forwarded-For (Railway's edge = 1, the default).
# The client IP is read that many entries from the right, so callers can't fake it for rate limits.
# TRUSTED_PROXY_HOPS=1

# Shared secret that protects /api/jobs/* (scripts/cron.mjs sends it).
CRON_SECRET=

# Chat and device simulators in production (demo environments only). Off unless set to 1.
# ENABLE_SIMULATORS=1

# Where integration requests are emailed (optional).
# OPS_EMAIL=

# WhatsApp Business Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Graph API version (Meta retires old ones; check developers.facebook.com/docs/graph-api/changelog)
# WHATSAPP_GRAPH_VERSION=v26.0
# The shared LekkerWerk number every company can use (empty until Meta approves it)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_ACCESS_TOKEN=

# PayFast (https://www.payfast.co.za). Keep real values out of git.
# Use sandbox until you're ready to take real payments.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Dev only: let ITN logic be tested locally without PayFast's IP/validate callbacks.
# PAYFAST_SKIP_REMOTE_CHECKS=1
# Dev only: allow LIVE checkout while APP_URL is not a public https URL. Leave unset.
# PAYFAST_ALLOW_LOCAL_LIVE=1
